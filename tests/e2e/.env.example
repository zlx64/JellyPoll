# Copy this file to `.env` and fill in your values.
# The E2E runner (npm run setup / npm run all) and docker compose both read it.

# --- Jellyfin server ---
# Docker image to run.
JELLYFIN_IMAGE=jellyfin/jellyfin:12.1

# Host port the server is exposed on (mapped to container port 8096).
JELLYFIN_HOST_PORT=8096

# Server name shown in the Jellyfin UI.
SERVER_NAME=JellyPoll E2E

# --- Media ---
# Absolute path to a folder of movies on THIS machine.
# It is mounted read-only into the server at /media/movies and scanned as a
# "Movies" library. The E2E tests discover movies from this library dynamically,
# so any movies work (at least 3 needed).
#   Windows (Docker Desktop):  F:\Movies
#   Linux / macOS:             /absolute/path/to/movies
MOVIES_FOLDER=F:\Movies

# --- Credentials ---
# Admin account created during the Jellyfin first-time setup.
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=change-me

# --- Plugin ---
# Plugin version; must match src/Jellyfin.Plugin.JellyPoll/meta.json "version".
PLUGIN_VERSION=1.0.1.0
